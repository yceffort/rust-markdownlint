{
  "problemMatcher": [
    {
      "owner": "rust-markdownlint",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+)(?::(\\d+))? (error|warning) (\\S+) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      ]
    }
  ]
}
